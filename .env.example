# DePin.Builders environment. Copy to .env.local and fill in. Never commit a real .env.

# Database (Vercel Postgres, Supabase, or Neon)
DATABASE_URL=

# Site
NEXT_PUBLIC_SITE_URL=https://depin.builders

# Auth (Clerk shown; Auth.js equivalents if you choose it)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Newsletter (Phase 7)
RESEND_API_KEY=

# Live token + network data (Phase 8)
COINGECKO_API_KEY=

# Cron job authentication
CRON_SECRET=

# Analytics
NEXT_PUBLIC_ANALYTICS_DOMAIN=
